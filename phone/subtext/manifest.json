{
  "id": "com.dynag.subtext.phone",
  "name": "GM Subtext",
  "version": "1.0.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "permissions": [
    { "name": "storage", "required": true },
    { "name": "device.info", "required": true },
    { "name": "device.events", "required": true, "scope": { "types": ["connection"] } },
    { "name": "device.messaging", "required": true, "scope": { "channels": [21333, 21334] } },
    { "name": "audio.capture", "required": true },
    { "name": "network", "required": true }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.dynag.subtext.glass",
    "requiredPluginId": "com.dynag.subtext.glass",
    "minPluginVersion": "1",
    "protocols": [
      { "id": "gm.subtext", "minVersion": "1.0" },
      { "id": "gm.device-events", "minVersion": "1.0" }
    ]
  },
  "schemaVersion": 2,
  "permissionPolicyVersion": 1
}
